# ============================================================
# Mediav2 — Environment Configuration
# Copy this file to .env and replace values where required.
# NEVER commit .env or real secrets to GitHub.
# ============================================================


# ============================================================
# SERVER
# ============================================================

# Port used by the Express server.
# Render automatically provides PORT, so normally leave this
# commented when deploying to Render.
# PORT=3000

# Bind address.
HOST=0.0.0.0

# Node environment.
NODE_ENV=production


# ============================================================
# MEDIAV2 PUBLIC URL
# ============================================================

# Your deployed Mediav2 URL.
#
# Example:
# https://your-app-name.onrender.com
#
# Used when generating links/manifests.
MEDIAV2_PUBLIC_URL=https://your-app-name.onrender.com


# ============================================================
# CLOU DSTREAM REPOSITORIES
# ============================================================

# Phisher CloudStream repository.
CLOUDSTREAM_PHISHER_REPO=https://raw.githubusercontent.com/phisher98/cloudstream-extensions-phisher/refs/heads/builds/repo.json

# CSX CloudStream repository.
CLOUDSTREAM_CSX_REPO=https://raw.githubusercontent.com/SaurabhKaperwan/CSX/builds/CS.json

# Additional CloudStream repositories can be supplied as a
# comma-separated list.
#
# Example:
# CLOUDSTREAM_REPOSITORIES=https://example.com/repo.json,https://example2.com/repo.json
CLOUDSTREAM_REPOSITORIES=


# ============================================================
# EXTENSIONS TO ENABLE
# ============================================================

# These are matched against the real CloudStream repository
# metadata. They are NOT fake/local providers.
CLOUDSTREAM_EXTENSIONS=StreamPlay,MovieBox,4KHDHUB,AniDB,AnimePahe,CineStream


# ============================================================
# CLOUDSTREAM RUNTIME / BRIDGE
# ============================================================

# URL of the CloudStream-compatible runtime service.
#
# IMPORTANT:
# Node/Mediav2 itself cannot execute .cs3 bytecode.
# This URL must point to the actual CloudStream-compatible
# execution layer.
#
# Example:
# CLOUDSTREAM_BRIDGE_URL=http://127.0.0.1:8080
#
# Leave empty until the runtime is deployed.
CLOUDSTREAM_BRIDGE_URL=


# Optional authentication token for the runtime bridge.
# Leave empty if your runtime does not require authentication.
CLOUDSTREAM_BRIDGE_TOKEN=


# Maximum time, in milliseconds, allowed for a runtime request.
CLOUDSTREAM_BRIDGE_TIMEOUT=30000


# ============================================================
# CLOU DSTREAM BRIDGE ENDPOINTS
# ============================================================

# The runtime is expected to expose endpoints corresponding
# to these operations.
#
# Search:
#   POST /search
#
# Home:
#   POST /home
#
# Load title:
#   POST /load
#
# Extract playable sources:
#   POST /sources
#
# These paths can be changed if your runtime uses different
# routes.

CLOUDSTREAM_BRIDGE_SEARCH_PATH=/search
CLOUDSTREAM_BRIDGE_HOME_PATH=/home
CLOUDSTREAM_BRIDGE_LOAD_PATH=/load
CLOUDSTREAM_BRIDGE_SOURCES_PATH=/sources


# ============================================================
# EXTENSION REGISTRY CACHE
# ============================================================

# How long the downloaded CloudStream repository metadata
# remains valid before another refresh.
#
# Value is milliseconds.
CLOUDSTREAM_REPOSITORY_CACHE_TTL=21600000

# Automatically synchronize extension metadata when the server
# starts.
CLOUDSTREAM_AUTO_SYNC=true

# Automatically synchronize extension metadata periodically.
CLOUDSTREAM_PERIODIC_SYNC=true

# Synchronization interval in milliseconds.
#
# 6 hours:
# 21600000
CLOUDSTREAM_SYNC_INTERVAL=21600000


# ============================================================
# LIBRARY
# ============================================================

# Automatically populate/update the local library from provider
# search/home results.
LIBRARY_AUTO_SYNC=true

# Maximum number of items stored in the local library.
LIBRARY_MAX_ITEMS=5000

# Library cache lifetime in milliseconds.
LIBRARY_CACHE_TTL=21600000


# ============================================================
# SEARCH
# ============================================================

# Maximum number of results returned by a global search.
SEARCH_LIMIT=100

# Maximum number of results requested from each provider.
SEARCH_PROVIDER_LIMIT=30

# Enable searching through all enabled CloudStream extensions.
SEARCH_CLOUDSTREAM_EXTENSIONS=true

# Enable native Mediav2 providers.
SEARCH_NATIVE_PROVIDERS=true


# ============================================================
# INTERNET ARCHIVE
# ============================================================

# Internet Archive is the built-in native provider.
ENABLE_INTERNET_ARCHIVE=true

# Maximum Internet Archive results per request.
INTERNET_ARCHIVE_LIMIT=50


# ============================================================
# PLAYBACK
# ============================================================

# Enable source resolution through the CloudStream runtime.
PLAYBACK_CLOUDSTREAM=true

# Enable native source resolution.
PLAYBACK_NATIVE=true

# Source request timeout in milliseconds.
SOURCE_TIMEOUT=30000

# Maximum sources returned for one title.
MAX_SOURCES=100


# ============================================================
# HLS
# ============================================================

# Enable HLS sources.
ENABLE_HLS=true

# Enable direct MP4/WebM sources.
ENABLE_DIRECT_VIDEO=true


# ============================================================
# CACHE
# ============================================================

# Directory for Mediav2 persistent data.
DATA_DIR=./data

# Cache directory.
CACHE_DIR=./data/cache

# Extension metadata cache.
EXTENSION_CACHE_FILE=./data/extensions.json

# Library cache.
LIBRARY_CACHE_FILE=./data/cache.json


# ============================================================
# HTTP
# ============================================================

# User-Agent used when retrieving public CloudStream manifests
# and other public provider metadata.
HTTP_USER_AGENT=Mediav2/2.0


# ============================================================
# CORS
# ============================================================

# Allowed origins.
#
# For development:
# CORS_ORIGIN=*
#
# For production, preferably use your actual frontend URL.
CORS_ORIGIN=*


# ============================================================
# LOGGING
# ============================================================

# Available levels:
# error
# warn
# info
# debug
LOG_LEVEL=info

# Print extension synchronization details.
LOG_EXTENSION_SYNC=true

# Print provider/search debugging information.
LOG_PROVIDER_REQUESTS=false


# ============================================================
# OPTIONAL SECURITY
# ============================================================

# If enabled, administrative endpoints can require a token.
ENABLE_ADMIN_AUTH=false

# Token used for administrative operations.
#
# Generate your own random value.
ADMIN_TOKEN=


# ============================================================
# OPTIONAL RUNTIME WORKER
# ============================================================

# If the CloudStream runtime is deployed separately, these can
# identify the runtime worker.

RUNTIME_WORKER_NAME=Mediav2-CloudStream-Runtime

# Runtime worker public URL, if different from
# CLOUDSTREAM_BRIDGE_URL.
RUNTIME_WORKER_URL=


# ============================================================
# GITHUB / EXTENSION BUILDING
# ============================================================

# GitHub repository containing Mediav2.
GITHUB_REPOSITORY=star884/Mediav2

# Branch containing generated CloudStream builds.
CLOUDSTREAM_BUILD_BRANCH=builds

# Raw URL for generated plugin repository metadata.
CLOUDSTREAM_GENERATED_REPO_URL=https://raw.githubusercontent.com/star884/Mediav2/builds/repo.json


# ============================================================
# OPTIONAL GITHUB TOKEN
# ============================================================

# Only required if Mediav2 itself needs to perform authenticated
# GitHub API operations.
#
# Prefer configuring this as a GitHub/Render secret rather than
# committing it anywhere.
GITHUB_TOKEN=


# ============================================================
# DEVELOPMENT
# ============================================================

# Set to true to enable development-oriented behavior.
DEV_MODE=false
